# Copy to .env.local and fill in. Every value is read on the server only.

# Required. YouCam API key from https://yce.perfectcorp.com/account/apikey
YOUCAM_API_KEY=

# Optional. Defaults shown.
# YOUCAM_API_BASE=https://yce-api-01.makeupar.com
# YOUCAM_SKIN_VERSION=v2.0

# Optional. When set, visitors must enter this code before an analysis runs.
# Use it on a public demo so strangers cannot spend your API units.
# ACCESS_CODE=

# Optional. Analyses per visitor per hour, and per server instance per day.
# RATE_LIMIT_PER_HOUR=20
# DAILY_ANALYSIS_CAP=150
