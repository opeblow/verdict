{
  "name": "verdict",
  "version": "1.0.0",
  "private": true,
  "description": "Verdict runs a personal, statistically honest trial of a skincare product using YouCam AI Skin Analysis, then tells you whether to keep buying it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opeblow/verdict.git"
  },
  "bugs": {
    "url": "https://github.com/opeblow/verdict/issues"
  },
  "homepage": "https://github.com/opeblow/verdict#readme",
  "keywords": [
    "skincare",
    "youcam",
    "perfect-corp",
    "skin-analysis",
    "nextjs",
    "statistics",
    "indexeddb",
    "privacy",
    "hackathon"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "smoke:youcam": "node scripts/youcam-smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
